<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="450.0" prefWidth="600.0" style="-fx-background-color: #f0f2f5;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.desktop.AddRoomController">
    <children>

        <Label alignment="CENTER" layoutX="0.0" layoutY="30.0" text="Add New Room" textFill="#2c3e50"
               AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="30.0">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <VBox alignment="CENTER" layoutX="150.0" layoutY="90.0" prefWidth="300.0" spacing="15.0"
              style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);"
              AnchorPane.leftAnchor="150.0" AnchorPane.rightAnchor="150.0" AnchorPane.topAnchor="90.0">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>
            <children>

                <Label maxWidth="Infinity" text="Room Number" />
                <TextField fx:id="txtRoomNumber" promptText="e.g. 101" style="-fx-padding: 10;" />

                <Label maxWidth="Infinity" text="Room Type" />
                <TextField fx:id="txtType" promptText="e.g. Deluxe / Standard" style="-fx-padding: 10;" />

                <Label maxWidth="Infinity" text="Price per Night" />
                <TextField fx:id="txtPrice" promptText="e.g. 5000" style="-fx-padding: 10;" />

                <Label fx:id="lblStatus" text="" textFill="RED" />

                <Button onAction="#handleSave" prefWidth="250.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10; -fx-cursor: hand;" text="Save Room">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Button>

            </children>
        </VBox>

        <Button layoutX="20.0" layoutY="20.0" mnemonicParsing="false" onAction="#handleBack" pickOnBounds="true"
                style="-fx-background-color: transparent; -fx-text-fill: #546E7A; -fx-border-color: #CFD8DC; -fx-border-radius: 5; -fx-cursor: hand;"
                text="← Back" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="20.0">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Button>

    </children>
</AnchorPane>