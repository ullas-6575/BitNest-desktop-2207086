<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="550.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.desktop.adminController">
    <children>

        <Label alignment="CENTER" layoutY="30.0" text="Admin Dashboard" textAlignment="CENTER"
               AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="30.0">
            <font>
                <Font name="System Bold" size="28.0" />
            </font>
        </Label>

        <VBox alignment="CENTER" spacing="15.0"
              AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="175.0"
              AnchorPane.rightAnchor="175.0" AnchorPane.topAnchor="90.0">
            <children>

                <Button fx:id="btnSeeGuests" mnemonicParsing="false" onAction="#handleSeeGuests" prefHeight="55.0" prefWidth="250.0" text="See Guests">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Button>

                <Button fx:id="btnAddRoom" mnemonicParsing="false" onAction="#handleAddRoom" prefHeight="55.0" prefWidth="250.0" text="Add Room">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Button>

                <Button fx:id="btnSearch" mnemonicParsing="false" onAction="#handleSearch" prefHeight="55.0" prefWidth="250.0" text="Search Guest">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Button>

                <Button fx:id="btnModify" mnemonicParsing="false" onAction="#handleModify" prefHeight="55.0" prefWidth="250.0" text="Modify Booking">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Button>

                <Button fx:id="btnCheckout" mnemonicParsing="false" onAction="#handleCheckout" prefHeight="55.0" prefWidth="250.0" text="Confirm Checkout">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Button>

            </children>
        </VBox>

        <Button mnemonicParsing="false" onAction="#handleBackAction" pickOnBounds="true"
                style="-fx-background-color: transparent; -fx-text-fill: #546E7A; -fx-border-color: #CFD8DC; -fx-border-radius: 5; -fx-cursor: hand;"
                text="Back" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="20.0">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Button>

    </children>
</AnchorPane>