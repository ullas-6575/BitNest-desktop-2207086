<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="450.0" prefWidth="600.0" style="-fx-background-color: #f0f2f5;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.desktop.ModifyBookingController">
    <children>

        <Label alignment="CENTER" layoutY="30.0" text="Modify Booking (Move Guest)" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="30.0">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>

        <VBox alignment="CENTER" layoutX="125.0" layoutY="90.0" prefWidth="350.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);" AnchorPane.leftAnchor="125.0" AnchorPane.rightAnchor="125.0" AnchorPane.topAnchor="90.0">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>
            <children>

                <Label text="Move Guest From (Occupied Room):" />
                <ComboBox fx:id="cbFromRoom" prefHeight="35.0" prefWidth="300.0" promptText="Select current room..." />

                <Label text="To New Room (Available Room):" />
                <ComboBox fx:id="cbToRoom" prefHeight="35.0" prefWidth="300.0" promptText="Select new room..." />

                <Label fx:id="lblStatus" text="" wrapText="true">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Label>

                <Button mnemonicParsing="false" onAction="#handleMove" prefHeight="40.0" prefWidth="300.0" style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-cursor: hand;" text="Confirm Move">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Button>

            </children>
        </VBox>

        <Button layoutX="20.0" layoutY="20.0" mnemonicParsing="false" onAction="#handleBack" style="-fx-background-color: transparent; -fx-text-fill: #546E7A; -fx-border-color: #CFD8DC; -fx-border-radius: 5; -fx-cursor: hand;" text="← Back" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="20.0">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Button>

    </children>
</AnchorPane>